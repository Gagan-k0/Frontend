generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE ENTITIES (USERS & COMPANIES)
// -----------------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  phone     String?
  role      String    @default("USER") // SUPER_ADMIN, ADMIN, MANAGER, USER
  
  // Relations
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  
  managedBatches Batch[]     @relation("ManagerBatches")
  enrolments     Enrolment[]
  messagesSent   Message[]
  conversations  Conversation[]
  
  // Soft Delete for GDPR
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// CURRICULUM (PROGRAMS, STEPS, LESSONS, QUIZZES)
// -----------------------------------------------------------------------------

model Program {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  price       Float
  isActive    Boolean  @default(true)
  
  steps       Step[]
  batches     Batch[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Step {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  sequence    Int      // 1 to 11
  title       String
  description String?
  
  lessons     Lesson[]
  quiz        Quiz?
  overrides   BatchStepOverride[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([programId, sequence])
}

model Lesson {
  id          String      @id @default(uuid())
  stepId      String
  step        Step        @relation(fields: [stepId], references: [id], onDelete: Cascade)
  
  title       String
  type        String      // VIDEO, PDF, AUDIO
  mediaUrl    String      // AWS S3 / Mux Asset ID
  durationSec Int?
  
  progress    UserLessonProgress[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Quiz {
  id          String     @id @default(uuid())
  stepId      String     @unique
  step        Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  
  passMark    Int        @default(75) // Percentage required to pass
  questions   Question[]
  attempts    Attempt[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id          String   @id @default(uuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  text        String
  options     Option[]
}

model Option {
  id          String   @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  text        String
  isCorrect   Boolean  @default(false)
}

// -----------------------------------------------------------------------------
// ENROLMENT & BATCH MANAGEMENT
// -----------------------------------------------------------------------------

model Batch {
  id          String   @id @default(uuid())
  name        String
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  
  managerId   String?
  manager     User?    @relation("ManagerBatches", fields: [managerId], references: [id])
  
  startDate   DateTime
  capacity    Int
  
  enrolments  Enrolment[]
  sessions    Session[]
  overrides   BatchStepOverride[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enrolment {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  
  batchId        String
  batch          Batch           @relation(fields: [batchId], references: [id])
  
  status         String          @default("PENDING_PAYMENT") // PENDING_PAYMENT, PENDING_AGREEMENT, ACTIVE, WAITLIST, COMPLETED, REVOKED
  agreementUrl   String?         // AWS S3 URL to signed PDF
  
  attempts       Attempt[]
  lessonProgress UserLessonProgress[]
  attendance     Attendance[]
  certificate    Certificate?
  payments       Payment[]
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, batchId])
}

// -----------------------------------------------------------------------------
// PROGRESSION TRACKING & LOGIC GATES
// -----------------------------------------------------------------------------

model UserLessonProgress {
  id          String    @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  viewed      Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  @@unique([enrolmentId, lessonId])
}

model Attempt {
  id          String        @id @default(uuid())
  enrolmentId String
  enrolment   Enrolment     @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  score       Int?
  status      String        @default("IN_PROGRESS") // IN_PROGRESS, PASSED, FAILED
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BatchStepOverride {
  id         String   @id @default(uuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stepId     String
  step       Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  
  isUnlocked Boolean  @default(false)
  unlockDate DateTime? // For DRIP schedules
  
  @@unique([batchId, stepId])
}

// -----------------------------------------------------------------------------
// SYNCHRONOUS OPERATIONS (ZOOM SESSIONS)
// -----------------------------------------------------------------------------

model Session {
  id              String       @id @default(uuid())
  batchId         String
  batch           Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  
  title           String
  startTime       DateTime
  endTime         DateTime
  zoomMeetingId   String?
  joinUrl         String?
  
  attendancePulled Boolean     @default(false)
  attendances     Attendance[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Attendance {
  id          String    @id @default(uuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  
  joinTime    DateTime?
  leaveTime   DateTime?
  durationMin Int?
  
  @@unique([sessionId, enrolmentId])
}

// -----------------------------------------------------------------------------
// PAYMENTS & CERTIFICATIONS
// -----------------------------------------------------------------------------

model Payment {
  id             String    @id @default(uuid())
  enrolmentId    String
  enrolment      Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  
  stripeSessionId String   @unique
  amount         Float
  currency       String    @default("USD")
  status         String    // e.g., 'succeeded', 'failed'
  
  createdAt      DateTime  @default(now())
}

model Certificate {
  id          String    @id @default(uuid())
  enrolmentId String    @unique
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  
  pdfUrl      String    // AWS S3 permanent URL for cert
  issuedAt    DateTime  @default(now())
}

// -----------------------------------------------------------------------------
// COMMUNICATIONS (CHAT)
// -----------------------------------------------------------------------------

model Conversation {
  id          String    @id @default(uuid())
  participants User[]   
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content        String
  attachmentUrl  String?
  read           Boolean      @default(false)
  
  createdAt      DateTime     @default(now())
}
